{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "clean-debug-bin",
            "type": "process",
            "command": "rm",
            "args": ["-f", "${workspaceFolder}/bin/gateway"]
        },
        {
            "label": "build-debug",
            "type": "process",
            "command": "make",
            "args": ["build-debug"],
            "dependsOn": ["clean-debug-bin"],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$go"
        }
    ]
}
