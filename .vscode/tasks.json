{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "clean-debug-bin",
            "type": "process",
            "command": "rm",
            "args": [
                "-f",
                "${workspaceFolder}/bin/gateway"
            ]
        },
        {
            "label": "build-debug",
            "type": "process",
            "command": "make",
            "args": [
                "build-debug"
            ],
            "dependsOn": [
                "clean-debug-bin"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$go"
        },
        {
            "label": "run-tunnel-client-debug",
            "type": "process",
            "command": "${workspaceFolder}/scripts/tunnel-client-debug.sh",
            "isBackground": true,
            "dependsOn": [
                "build-debug"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "base": "$go",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "API server.*"
                }
            }
        },
        {
            "label": "kill-tunnel-client-debug",
            "type": "process",
            "command": "${workspaceFolder}/scripts/tunnel-client-debug-clean.sh",
            "problemMatcher": []
        }
    ]
}
